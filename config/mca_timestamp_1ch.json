{
    "bitfile": "bitfiles/mca_timestamp_1ch.bit",
    "description": "MCA chain (IIR1 -> FIR9 -> Peak Detector -> Histogram) plus a continuous event_logger that timestamps each in-band peak (48-bit us counter), tags it with channel-B digital state, and streams 64-bit records out via ping-pong BRAM + CDMA. NTP tie-points give absolute drift-corrected time.",
    "build_date": "2026-07-28",

    "acquisition": {
        "_comment": "Addresses MUST match the block-design Address Editor; placeholders below follow the stream_cdma convention. One CDMA engine drains both BRAMs (different source addresses).",
        "logger_base":   "0x40004000",
        "logger_bram":   "0x41000000",
        "histogram_bram":"0x42000000",
        "histogram_bytes": 131072,
        "histogram_bytes_comment": "32768 bins x 4 bytes; read via read_bram_fast(histogram_bram, cdma, ddr, 131072) -> np.frombuffer(dtype='<u4')",
        "cdma_addr":     "0x7E200000",
        "ddr_addr":      "0x10000000",
        "record_bytes": 8,
        "record_layout": "bits[47:0]=timestamp_us, bits[62:48]=energy(15b), bit[63]=chb",
        "frame_len": 4096,
        "presc": 125,
        "presc_comment": "clk cycles per microsecond tick; 125 for a 125 MHz processing clock"
    },

    "modules": {

        "peak_detector": {
            "type": "peak_detector",
            "settings": { "DATA_WIDTH": 16, "COUNTER_WIDTH": 16, "timebase_rp": 8e-9, "timebase_module": 16e-9 },
            "registers": {
                "trig_level":   {"base": "0x40002000", "offset":  0, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "base_return":  {"base": "0x40002000", "offset":  8, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "dead_time":    {"base": "0x40002000", "offset": 12, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0},
                "n_integration":{"base": "0x40002000", "offset": 20, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0}
            }
        },

        "histogram_cdma": {
            "type": "peak_height_binning_cdma",
            "settings": {
                "PEAK_DATA_WIDTH": 16,
                "BIN_COUNT_WIDTH": 32,
                "LOG_NBINS": 15,
                "histogram_bins": 32768,
                "GAIN_WIDTH": 16,
                "readout": "CDMA block read of histogram_bram (see acquisition), NOT register peek",
                "timebase_rp": 8e-9
            },
            "registers": {
                "offset":          {"base": "0x40003000", "offset":  0, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 10},
                "gain":            {"base": "0x40003000", "offset":  4, "msb": 15, "lsb": 0, "signed": false, "log_scale": 8},
                "band_low":        {"base": "0x40003000", "offset":  8, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "band_high":       {"base": "0x40003000", "offset": 12, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "clear_bins":      {"base": "0x40003000", "offset": 16, "msb":  0, "lsb": 0, "signed": false, "log_scale": 0},
                "counting_enable": {"base": "0x40003000", "offset": 16, "msb":  1, "lsb": 1, "signed": false, "log_scale": 0},
                "reset":           {"base": "0x40003000", "offset": 16, "msb":  2, "lsb": 2, "signed": false, "log_scale": 0},
                "pulse_width":     {"base": "0x40003000", "offset": 20, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0},
                "overflow_flag":   {"base": "0x40003000", "offset": 28, "msb":  0, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "clearing_active": {"base": "0x40003000", "offset": 28, "msb":  1, "lsb": 1, "signed": false, "log_scale": 0, "readonly": true}
            }
        },

        "event_logger": {
            "type": "event_logger",
            "settings": {
                "TS_WIDTH": 48,
                "E_WIDTH": 15,
                "REC_WIDTH": 64,
                "ADDR_BITS": 13,
                "buffers": 2,
                "records_per_buffer": 4096,
                "timebase_rp": 8e-9
            },
            "registers": {
                "control":       {"base": "0x40004000", "offset":  0, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0,
                                  "bits": "0=arm 1=clear_ts 2=reset 3=snap 4=ack"},
                "arm":           {"base": "0x40004000", "offset":  0, "msb":  0, "lsb": 0, "signed": false, "log_scale": 0},
                "clear_ts":      {"base": "0x40004000", "offset":  0, "msb":  1, "lsb": 1, "signed": false, "log_scale": 0},
                "reset":         {"base": "0x40004000", "offset":  0, "msb":  2, "lsb": 2, "signed": false, "log_scale": 0},
                "snap":          {"base": "0x40004000", "offset":  0, "msb":  3, "lsb": 3, "signed": false, "log_scale": 0},
                "ack":           {"base": "0x40004000", "offset":  0, "msb":  4, "lsb": 4, "signed": false, "log_scale": 0},
                "presc":         {"base": "0x40004000", "offset":  4, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0},
                "frame_len":     {"base": "0x40004000", "offset":  8, "msb": 12, "lsb": 0, "signed": false, "log_scale": 0},
                "flush_ticks":   {"base": "0x40004000", "offset": 12, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0},
                "band_low":      {"base": "0x40004000", "offset": 16, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "band_high":     {"base": "0x40004000", "offset": 20, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "chb_threshold": {"base": "0x40004000", "offset": 24, "msb": 15, "lsb": 0, "signed": true,  "log_scale": 15},
                "status":        {"base": "0x40004000", "offset": 32, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true,
                                  "bits": "0=ready 1=ready_buf 2=dropped_nonzero"},
                "ready":         {"base": "0x40004000", "offset": 32, "msb":  0, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "ready_buf":     {"base": "0x40004000", "offset": 32, "msb":  1, "lsb": 1, "signed": false, "log_scale": 0, "readonly": true},
                "ready_count":   {"base": "0x40004000", "offset": 36, "msb": 12, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "dropped":       {"base": "0x40004000", "offset": 40, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "ts_snap_lo":    {"base": "0x40004000", "offset": 44, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "ts_snap_hi":    {"base": "0x40004000", "offset": 48, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "events_lo":     {"base": "0x40004000", "offset": 52, "msb": 31, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true},
                "events_hi":     {"base": "0x40004000", "offset": 56, "msb": 15, "lsb": 0, "signed": false, "log_scale": 0, "readonly": true}
            }
        }
    }
}
